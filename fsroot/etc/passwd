# HNeoC OS account table
#
# One account per line, fields separated by colons:
#     name:password_hash:uid:home:admin
#
# password_hash is djb2 of the password, written as 8 hex digits.
# This only keeps plaintext passwords off the disk - it is NOT security:
# there is no salt, the algorithm is public, and anyone who can write
# this file can simply add an account for themselves.
#
# admin = 1 allows administrative commands (adding accounts, writing
# to files owned by other users). uid 0 is always root.

root:7c9d79a9:0:/:1
livy:7c9a16c9:1000:/home:1
guest:0f88c14d:1001:/home:0
